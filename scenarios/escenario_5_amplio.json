{
  "scenario": {
    "id": "escenario_5",
    "name": "Escenario amplio con interbloqueo de tres vías",
    "description": "Cinco procesos y cuatro recursos. Analista, Diseñador y Editor forman un ciclo de espera circular de tres procesos (no solo el caso trivial de dos), mientras Monitor_Red y Respaldo_Nocturno comparten un recurso de red con cupo para dos y se completan sin verse afectados por el interbloqueo. Demuestra que la detección y la recuperación no dependen de un ejemplo pequeño ni de nombres fijos como P1/R1."
  },

  "system": {
    "memory_total": 2000
  },

  "resources": [
    {
      "id": "printer",
      "name": "Impresora",
      "type": "exclusive",
      "quantity": 1
    },
    {
      "id": "disk",
      "name": "Disco",
      "type": "exclusive",
      "quantity": 1
    },
    {
      "id": "scanner",
      "name": "Escáner",
      "type": "exclusive",
      "quantity": 1
    },
    {
      "id": "network",
      "name": "Ancho de banda de red",
      "type": "shared",
      "quantity": 2
    }
  ],

  "files": [
    { "id": "reporte_final", "name": "reporte_final.txt", "size": 0 },
    { "id": "respaldo_bin", "name": "respaldo.bin", "size": 0 },
    { "id": "config_cfg", "name": "config.cfg", "size": 10 }
  ],

  "processes": [
    {
      "pid": 1,
      "name": "Analista",
      "memory_required": 300,
      "required_resources": ["printer", "disk"],
      "actions": [
        { "id": "p1_a1", "type": "request_memory", "amount": 300 },
        { "id": "p1_a2", "type": "request_resource", "resource": "printer" },
        { "id": "p1_a3", "type": "request_resource", "resource": "disk" },
        { "id": "p1_a4", "type": "write_file", "file": "reporte_final", "new_size": 120 },
        { "id": "p1_a5", "type": "release_resource", "resource": "disk" },
        { "id": "p1_a6", "type": "release_resource", "resource": "printer" },
        { "id": "p1_a7", "type": "release_memory" },
        { "id": "p1_a8", "type": "terminate" }
      ]
    },

    {
      "pid": 2,
      "name": "Disenador",
      "memory_required": 300,
      "required_resources": ["disk", "scanner"],
      "actions": [
        { "id": "p2_a1", "type": "request_memory", "amount": 300 },
        { "id": "p2_a2", "type": "request_resource", "resource": "disk" },
        { "id": "p2_a3", "type": "request_resource", "resource": "scanner" },
        { "id": "p2_a4", "type": "write_file", "file": "respaldo_bin", "new_size": 80 },
        { "id": "p2_a5", "type": "release_resource", "resource": "scanner" },
        { "id": "p2_a6", "type": "release_resource", "resource": "disk" },
        { "id": "p2_a7", "type": "release_memory" },
        { "id": "p2_a8", "type": "terminate" }
      ]
    },

    {
      "pid": 3,
      "name": "Editor",
      "memory_required": 300,
      "required_resources": ["scanner", "printer"],
      "actions": [
        { "id": "p3_a1", "type": "request_memory", "amount": 300 },
        { "id": "p3_a2", "type": "request_resource", "resource": "scanner" },
        { "id": "p3_a3", "type": "request_resource", "resource": "printer" },
        { "id": "p3_a4", "type": "read_file", "file": "config_cfg" },
        { "id": "p3_a5", "type": "release_resource", "resource": "printer" },
        { "id": "p3_a6", "type": "release_resource", "resource": "scanner" },
        { "id": "p3_a7", "type": "release_memory" },
        { "id": "p3_a8", "type": "terminate" }
      ]
    },

    {
      "pid": 4,
      "name": "Monitor_Red",
      "memory_required": 150,
      "required_resources": ["network"],
      "actions": [
        { "id": "p4_a1", "type": "request_memory", "amount": 150 },
        { "id": "p4_a2", "type": "request_resource", "resource": "network" },
        { "id": "p4_a3", "type": "read_file", "file": "config_cfg" },
        { "id": "p4_a4", "type": "release_resource", "resource": "network" },
        { "id": "p4_a5", "type": "release_memory" },
        { "id": "p4_a6", "type": "terminate" }
      ]
    },

    {
      "pid": 5,
      "name": "Respaldo_Nocturno",
      "memory_required": 200,
      "required_resources": ["network"],
      "actions": [
        { "id": "p5_a1", "type": "request_memory", "amount": 200 },
        { "id": "p5_a2", "type": "request_resource", "resource": "network" },
        { "id": "p5_a3", "type": "write_file", "file": "respaldo_bin", "new_size": 200 },
        { "id": "p5_a4", "type": "release_resource", "resource": "network" },
        { "id": "p5_a5", "type": "release_memory" },
        { "id": "p5_a6", "type": "terminate" }
      ]
    }
  ]
}
