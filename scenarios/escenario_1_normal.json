{
  "scenario": {
    "id": "escenario_1",
    "name": "Ejecución normal sin interbloqueo",
    "description": "Dos procesos comparten recursos sin generar interbloqueo."
  },

  "system": {
    "memory_total": 1000
  },

  "resources": [
    {
      "id": "printer",
      "name": "Impresora",
      "type": "exclusive",
      "quantity": 1
    },
    {
      "id": "disk",
      "name": "Disco",
      "type": "exclusive",
      "quantity": 1
    }
  ],

  "files": [
    {
      "id": "file_a",
      "name": "documento.txt",
      "size": 100
    },
    {
      "id": "file_b",
      "name": "reporte.txt",
      "size": 50
    }
  ],

  "processes": [
    {
      "pid": 1,
      "name": "Editor",
      "memory_required": 300,
      "required_resources": [
        "printer"
      ],
      "actions": [
        {
          "id": "p1_a1",
          "type": "request_memory",
          "amount": 300
        },
        {
          "id": "p1_a2",
          "type": "request_resource",
          "resource": "printer"
        },
        {
          "id": "p1_a3",
          "type": "write_file",
          "file": "file_a",
          "new_size": 150
        },
        {
          "id": "p1_a4",
          "type": "create_file",
          "file": "file_c",
          "name": "temporal.tmp",
          "size": 10
        },
        {
          "id": "p1_a5",
          "type": "write_file",
          "file": "file_c",
          "new_size": 60
        },
        {
          "id": "p1_a6",
          "type": "move_file",
          "file": "file_c",
          "new_name": "temporal_procesado.tmp"
        },
        {
          "id": "p1_a7",
          "type": "delete_file",
          "file": "file_c"
        },
        {
          "id": "p1_a8",
          "type": "release_resource",
          "resource": "printer"
        },
        {
          "id": "p1_a9",
          "type": "release_memory"
        },
        {
          "id": "p1_a10",
          "type": "terminate"
        }
      ]
    },

    {
      "pid": 2,
      "name": "Generador de reportes",
      "memory_required": 250,
      "required_resources": [
        "disk"
      ],
      "actions": [
        {
          "id": "p2_a1",
          "type": "request_memory",
          "amount": 250
        },
        {
          "id": "p2_a2",
          "type": "request_resource",
          "resource": "disk"
        },
        {
          "id": "p2_a3",
          "type": "read_file",
          "file": "file_b"
        },
        {
          "id": "p2_a4",
          "type": "release_resource",
          "resource": "disk"
        },
        {
          "id": "p2_a5",
          "type": "release_memory"
        },
        {
          "id": "p2_a6",
          "type": "terminate"
        }
      ]
    }
  ]
}